{
  "name": "byjdg-website-studio",
  "productName": "by JDG Website Studio",
  "version": "1.0.0",
  "description": "Desktop website studio for ByJDG",
  "main": "main.js",
  "author": "JDG",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac"
  },
  "build": {
    "appId": "com.byjdg.websitestudio",
    "productName": "by JDG Website Studio",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "files": [
      "admin.html",
      "cms-server.js",
      "index.html",
      "main.js",
      "package.json",
      "images/**/*",
      "projects.html",
      "projects-cms.js",
      "projects-fields.json",
      "cinema-cms.js",
      "page-meta.js",
      "site-branding.js",
      "section-tones.js",
      "deliveries.js",
      "studio-deliveries.js",
      "delivery-page.html"
    ]
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.0.12"
  }
}
